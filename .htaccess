# SPA routing for React Router (BrowserRouter) on Apache / Hostinger.
# Any request that is NOT a real file or directory is served index.html,
# so deep links like /courses or /contact work on refresh and direct visits.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite real files or directories (assets, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html (React Router takes over client-side)
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache the fingerprinted build assets (safe: filenames change on rebuild).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Never cache the HTML shell, so new deploys are picked up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
